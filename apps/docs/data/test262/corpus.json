  {
    "id": "statements-while-cptn-iter",
    "test262Path": "test/language/statements/while/cptn-iter.js",
    "esid": "sec-while-statement",
    "category": "statements",
    "description": "while (i < 3) { sum += i; i++ } → sum === 3",
    "spec": {
      "type": "then",
      "params": {
        "nodes": [
          {
            "type": "set",
            "params": {
              "path": "$.i",
              "value": 0
            }
          },
          {
            "type": "set",
            "params": {
              "path": "$.sum",
              "value": 0
            }
          },
          {
            "type": "while",
            "params": {
              "condition": {
                "$lt": [
                  "$.i",
