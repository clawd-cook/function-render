    "id": "statements-for-12.6.3_2-3-a-ii-10",
    "test262Path": "test/language/statements/for/12.6.3_2-3-a-ii-10.js",
    "esid": "sec-for-statement",
    "category": "statements",
    "description": "for-loop accumulation: sum([1,2,3,4]) === 10",
    "spec": {
      "type": "then",
      "params": {
        "nodes": [
          {
            "type": "set",
            "params": {
              "path": "$.sum",
              "value": 0
            }
          },
          {
            "type": "for",
            "params": {
              "items": "$.input.nums",
              "itemKey": "n",
              "maxIter": 1000,
              "body": {
                "type": "set",
                "params": {
                  "path": "$.sum",
                  "value": {
                    "$add": [
                      "$.sum",
                      "$.n"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "get",
            "params": {
              "path": "$.sum"
            }
          }
        ]
      }
    },
    "input": {
      "nums": [
        1,
        2,
        3,
        4
      ]
    },
    "expectation": {
      "kind": "value",
      "expected": 10
    }
  },
